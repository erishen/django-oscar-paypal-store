# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production-environment

# Database Settings (PostgreSQL - Default)
DATABASE_ENGINE=django.db.backends.postgresql_psycopg2
DATABASE_NAME=oscar_db
DATABASE_USER=oscar_user
DATABASE_PASSWORD=oscar_password
# DATABASE_HOST and DATABASE_PORT are set in docker-compose.yml

# Optional: Use SQLite instead of PostgreSQL
# DATABASE_ENGINE=django.db.backends.sqlite3
# DATABASE_NAME=/app/sandbox/db.sqlite

# --- PayPal Express Checkout (sandbox) ---
# Get real sandbox credentials at https://developer.paypal.com
# Copy this file to .env and fill in the two values below.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_MODE=sandbox

# --- Web server host port (optional) ---
# The container always listens on 8080 internally. This controls which port is
# published on the host. Defaults to 8080. If 8080 is already in use on the
# host (e.g. another container is bound to it), set this to a free port:
WEB_PORT=8080

# --- Allowed hosts (optional) ---
# Comma-separated list of host/domain names Django will accept. When you access
# the site through a reverse proxy or a custom domain (e.g. shop.example.com),
# add that domain here or Django rejects it with DisallowedHost. If unset,
# defaults to: localhost,127.0.0.1,web
ALLOWED_HOSTS=localhost,127.0.0.1,web
